{
  "expo": {
    "name": "EduSense",
    "slug": "edusense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0f172a" },
      "permissions": ["CAMERA"]
    },
    "plugins": [["expo-camera", { "cameraPermission": "EduSense needs camera for QR attendance." }]]
  }
}
