# Copy this file to .env and fill in real values. Never commit .env to git.

# Gmail app password for sending credential emails (vite dev-server only)
VITE_SMTP_USER=edusense.system@gmail.com
VITE_SMTP_PASS=your_gmail_app_password_here

# Public URL of the deployed site (used in email links)
# Development:   http://localhost:5173
# Production:    https://yourdomain.hostinger.com
VITE_APP_URL=http://localhost:5173

# Backend API URL (FastAPI server)
# Development:   http://localhost:8000
# Production:    https://your-app.railway.app  (or Render URL)
VITE_API_URL=http://localhost:8000
