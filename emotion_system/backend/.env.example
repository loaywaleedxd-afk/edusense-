# Copy to .env (never commit .env)

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# SQLite database file path (relative to working directory)
DB_PATH=emotion_system.db

# Comma-separated list of allowed CORS origins (your Hostinger domain + localhost)
ALLOWED_ORIGINS=https://yourdomain.hostinger.com,http://localhost:5173

# Gmail SMTP credentials for sending credential emails
SMTP_USER=edusense.system@gmail.com
SMTP_PASS=your_gmail_app_password_here
