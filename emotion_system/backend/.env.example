# Copy to .env (never commit .env)

# PostgreSQL connection string
DATABASE_URL=postgresql://edusense:password@localhost:5432/edusense

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed CORS origins (your domain + localhost)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gmail SMTP credentials for sending credential emails
SMTP_USER=edusense.system@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Paymob HMAC secret for payment verification
PAYMOB_HMAC_SECRET=
