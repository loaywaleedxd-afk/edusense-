# Copy to .env on your VPS — never commit .env to git

# Your domain (e.g. edusense.yourdomain.com or yourdomain.com)
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=your@email.com

# JWT secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# PostgreSQL credentials (used by docker-compose db service + backend)
POSTGRES_DB=edusense
POSTGRES_USER=edusense
POSTGRES_PASSWORD=replace-with-strong-password

# Gmail SMTP for sending credential emails (optional)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
